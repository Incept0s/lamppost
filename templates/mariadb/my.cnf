# LAMPPost - MariaDB configuration
# The MariaDB program comes from Fedora (updated by dnf); your databases
# live in @PREFIX@/mariadb/data. Only reachable from this computer.
#
# Like XAMPP, the database user "root" has no password.

[client]
port = 3306
socket = "@PREFIX@/tmp/mysql.sock"
default-character-set = utf8mb4

[mysqld]
port = 3306
bind-address = 127.0.0.1
socket = "@PREFIX@/tmp/mysql.sock"
datadir = "@PREFIX@/mariadb/data"
pid-file = "@PREFIX@/mariadb/data/mariadb.pid"
log-error = "@PREFIX@/mariadb/data/mariadb_error.log"
tmpdir = "@PREFIX@/tmp"

character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
skip-name-resolve
max_allowed_packet = 64M
innodb_buffer_pool_size = 128M

[mysqldump]
max_allowed_packet = 64M
